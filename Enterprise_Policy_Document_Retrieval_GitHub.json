      "name": "Embeddings OpenAI"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst results = items.map((item, index) => {\n  const doc = item.json.document ?? {};\n  const metadata = doc.metadata ?? {};\n\n  const content =\n    doc.pageContent ??\n    item.json.pageContent ??\n    \"\";\n\n  const label =\n    metadata.label ??\n    item.json.label ??\n    \"Unknown Policy\";\n\n  const score = item.json.score ?? null;\n\n  return {\n    rank: index + 1,\n    label,\n    content,\n    score\n  };\n});\n\nconst context = results.map(result => {\n  return [\n    `Source ${result.rank}: ${result.label}`,\n    `Content: ${result.content}`\n  ].join(\"\\n\");\n}).join(\"\\n\\n---\\n\\n\");\n\nreturn [\n  {\n    json: {\n      question: $('When Executed by Another Workflow').first().json.question,\n      context,\n      sources: results.map(result => ({\n        label: result.label,\n        score: result.score\n      })),\n      retrievedCount: results.length\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
